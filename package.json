{
  "name": "@ramstack/vue-pagelock",
  "version": "1.1.0",
  "description": "A lightweight utility for managing page scroll locking in `Vue` applications",
  "type": "module",
  "author": "rameel <rameel-b@hotmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rameel/vue-pagelock.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/vue-pagelock.d.ts",
        "default": "./dist/vue-pagelock.esm.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "prebuild": "pnpm run clean",
    "clean": "rimraf dist",
    "size-report": "node scripts/compare-package-sizes.js"
  },
  "keywords": [
    "pagelock",
    "page-locking",
    "scroll-locking",
    "scroll-lock"
  ],
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@ramstack/pagelock": "^1.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.5",
    "terser": "^5.50.0",
    "tslib": "^2.8.1"
  }
}
